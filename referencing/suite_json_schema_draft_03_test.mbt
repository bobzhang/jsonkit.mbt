      #|    {
      #|      "ref": "http://example.com/case-insensitive-host",
      #|      "target": { "baz": "quux" }
      #|    },
      #|    {
      #|      "ref": "http://example.com/case-sensitive-path",
      #|      "error": true
      #|    },
      #|    {
      #|      "ref": "http://example.com/escapes/a%C2%B1b",
      #|      "target": { "spam": "eggs" }
      #|    },
      #|    {
      #|      "ref": "http://example.com/unreserved/~foo",
      #|      "target": { "snap": "crackle" }
      #|    },
      #|    {
      #|      "ref": "http://example.com/default/port",
      #|      "target": { "pop": 37 }
      #|    }
      #|  ]
      #|}
    ),
  )
}

