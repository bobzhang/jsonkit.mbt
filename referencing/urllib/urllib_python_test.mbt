    ("svn+ssh://host/repo/trunk", "mailto:x@y", "mailto:x@y"),
    ("svn+ssh://host/repo/trunk", "file:other.json", "file:other.json"),
    ("svn+ssh://host/repo/trunk", "nested/../../up", "svn+ssh://host/up"),
    ("svn+ssh://host/repo/trunk", "a//b", "svn+ssh://host/repo/a/b"),
    ("svn+ssh://host/repo/trunk", "//", "svn+ssh://host/repo/trunk"),
    ("svn+ssh://host/repo/trunk", "///x", "svn+ssh://host/x"),
    ("itms-services://example/a/b", "", "itms-services://example/a/b"),
    ("itms-services://example/a/b", "#", "#"),
    ("itms-services://example/a/b", "#foo", "#foo"),
    ("itms-services://example/a/b", "#/definitions/a", "#/definitions/a"),
    ("itms-services://example/a/b", "#/$defs/a%25b", "#/$defs/a%25b"),
    ("itms-services://example/a/b", "g", "g"),
    ("itms-services://example/a/b", "./g", "./g"),
    ("itms-services://example/a/b", "g/", "g/"),
    ("itms-services://example/a/b", "/g", "/g"),
    ("itms-services://example/a/b", "//g", "//g"),
    ("itms-services://example/a/b", "?y", "?y"),
    ("itms-services://example/a/b", "g?y", "g?y"),
    ("itms-services://example/a/b", "g#s", "g#s"),
    ("itms-services://example/a/b", "g?y#s", "g?y#s"),
    ("itms-services://example/a/b", ";x", ";x"),
    ("itms-services://example/a/b", "g;x", "g;x"),
    ("itms-services://example/a/b", "g;x?y#s", "g;x?y#s"),
    ("itms-services://example/a/b", ".", "."),
    ("itms-services://example/a/b", "./", "./"),
    ("itms-services://example/a/b", "..", ".."),
    ("itms-services://example/a/b", "../", "../"),
    ("itms-services://example/a/b", "../g", "../g"),
    ("itms-services://example/a/b", "../..", "../.."),
    ("itms-services://example/a/b", "../../", "../../"),
    ("itms-services://example/a/b", "../../g", "../../g"),
    ("itms-services://example/a/b", "../../../g", "../../../g"),
    ("itms-services://example/a/b", "../../../../g", "../../../../g"),
    ("itms-services://example/a/b", "/./g", "/./g"),
    ("itms-services://example/a/b", "/../g", "/../g"),
    ("itms-services://example/a/b", "g.", "g."),
    ("itms-services://example/a/b", ".g", ".g"),
    ("itms-services://example/a/b", "g..", "g.."),
    ("itms-services://example/a/b", "..g", "..g"),
    ("itms-services://example/a/b", "./../g", "./../g"),
    ("itms-services://example/a/b", "./g/.", "./g/."),
    ("itms-services://example/a/b", "g/./h", "g/./h"),
    ("itms-services://example/a/b", "g/../h", "g/../h"),
    ("itms-services://example/a/b", "g;x=1/./y", "g;x=1/./y"),
    ("itms-services://example/a/b", "g;x=1/../y", "g;x=1/../y"),
    ("itms-services://example/a/b", "http:g", "http:g"),
    ("itms-services://example/a/b", "http:", "http:"),
    ("itms-services://example/a/b", "urn:example:bar", "urn:example:bar"),
    ("itms-services://example/a/b", "urn:example:foo#bar", "urn:example:foo#bar"),
    ("itms-services://example/a/b", "tag:example.com,2023:other", "tag:example.com,2023:other"),
    ("itms-services://example/a/b", "https://other.example/x", "https://other.example/x"),
    ("itms-services://example/a/b", "foo/bar/", "foo/bar/"),
    ("itms-services://example/a/b", "bar", "bar"),
    ("itms-services://example/a/b", "child/", "child/"),
    ("itms-services://example/a/b", "grandchild", "grandchild"),
    ("itms-services://example/a/b", "a%20b", "a%20b"),
    ("itms-services://example/a/b", "  leading-space", "  leading-space"),
    ("itms-services://example/a/b", "with\ttab", "with\ttab"),
    ("itms-services://example/a/b", "mailto:x@y", "mailto:x@y"),
    ("itms-services://example/a/b", "file:other.json", "file:other.json"),
    ("itms-services://example/a/b", "nested/../../up", "nested/../../up"),
    ("itms-services://example/a/b", "a//b", "a//b"),
    ("itms-services://example/a/b", "//", "//"),
    ("itms-services://example/a/b", "///x", "///x"),
  ]
  for case in cases {
    let (base, url, expected) = case
    let got = @urllib.urljoin(base, url)
    assert_eq(got, expected, msg="urljoin(\{base}, \{url})")
  }
}

///|
test "urlsplit and urlparse match CPython" {
  let cases : Array[(String, Array[String], Array[String])] = [
    ("http://example.com/a/b?c=d#e", ["http", "example.com", "/a/b", "c=d", "e"], ["http", "example.com", "/a/b", "", "c=d", "e"]),
    ("HTTP://EXAMPLE.com", ["http", "EXAMPLE.com", "", "", ""], ["http", "EXAMPLE.com", "", "", "", ""]),
    ("urn:example:foo#bar", ["urn", "", "example:foo", "", "bar"], ["urn", "", "example:foo", "", "", "bar"]),
    ("tag:example.com,2023:x", ["tag", "", "example.com,2023:x", "", ""], ["tag", "", "example.com,2023:x", "", "", ""]),
    ("mailto:a@b.c", ["mailto", "", "a@b.c", "", ""], ["mailto", "", "a@b.c", "", "", ""]),
    ("//netloc/path?q#f", ["", "netloc", "/path", "q", "f"], ["", "netloc", "/path", "", "q", "f"]),
    ("path;params?q#f", ["", "", "path;params", "q", "f"], ["", "", "path", "params", "q", "f"]),
    ("http://a/b;c/d;e?f#g", ["http", "a", "/b;c/d;e", "f", "g"], ["http", "a", "/b;c/d", "e", "f", "g"]),
    ("1http://x", ["", "", "1http://x", "", ""], ["", "", "1http://x", "", "", ""]),
    ("a+b-c.d:rest", ["a+b-c.d", "", "rest", "", ""], ["a+b-c.d", "", "rest", "", "", ""]),
    ("a_b:rest", ["", "", "a_b:rest", "", ""], ["", "", "a_b:rest", "", "", ""]),
    (":nope", ["", "", ":nope", "", ""], ["", "", ":nope", "", "", ""]),
    ("http://[::1]/", ["http", "[::1]", "/", "", ""], ["http", "[::1]", "/", "", "", ""]),
    ("http://[::ffff:1.2.3.4]:80/", ["http", "[::ffff:1.2.3.4]:80", "/", "", ""], ["http", "[::ffff:1.2.3.4]:80", "/", "", "", ""]),
    ("http://[fe80::1%25eth0]/", ["http", "[fe80::1%25eth0]", "/", "", ""], ["http", "[fe80::1%25eth0]", "/", "", "", ""]),
    ("http://[v1.fe]/", ["http", "[v1.fe]", "/", "", ""], ["http", "[v1.fe]", "/", "", "", ""]),
    ("  \u{0}http://example.com/  ", ["http", "example.com", "/  ", "", ""], ["http", "example.com", "/  ", "", "", ""]),
    ("ht\ttp://exa\nmple.com/\r", ["http", "example.com", "/", "", ""], ["http", "example.com", "/", "", "", ""]),
    ("#only-fragment", ["", "", "", "", "only-fragment"], ["", "", "", "", "", "only-fragment"]),
    ("?only-query", ["", "", "", "only-query", ""], ["", "", "", "", "only-query", ""]),
    ("", ["", "", "", "", ""], ["", "", "", "", "", ""]),
    ("file:///etc/passwd", ["file", "", "/etc/passwd", "", ""], ["file", "", "/etc/passwd", "", "", ""]),
    ("http://user@[::1]:99/x", ["http", "user@[::1]:99", "/x", "", ""], ["http", "user@[::1]:99", "/x", "", "", ""]),
    ("http://example.com:80", ["http", "example.com:80", "", "", ""], ["http", "example.com:80", "", "", "", ""]),
  ]
  for case in cases {
    let (url, s, p) = case
    let got = @urllib.urlsplit(url)
    assert_eq([got.scheme, got.netloc, got.path, got.query, got.fragment], s)
    let got = @urllib.urlparse(url)
    assert_eq(
      [got.scheme, got.netloc, got.path, got.params, got.query, got.fragment],
      p,
    )
    assert_eq(@urllib.urlsplit(url).geturl(), @urllib.urlunsplit(s[0], s[1], s[2], s[3], s[4]))
  }
}

///|
test "urlsplit raises ValueError like CPython" {
  let cases : Array[(String, String)] = [
    ("http://[::1/", "Invalid IPv6 URL"),
    ("http://::1]/", "Invalid IPv6 URL"),
    ("http://[1.2.3.4]/", "An IPv4 address cannot be in brackets"),
    ("http://[v.x]/", "IPvFuture address is invalid"),
    ("http://[vz.x]/", "IPvFuture address is invalid"),
    ("http://[::1]x/", "Invalid IPv6 URL"),
    ("http://x[::1]/", "Invalid IPv6 URL"),
    ("http://[::1::2]/", "'::1::2' does not appear to be an IPv4 or IPv6 address"),
    ("http://[12345::]/", "'12345::' does not appear to be an IPv4 or IPv6 address"),
    ("http://[hello]/", "'hello' does not appear to be an IPv4 or IPv6 address"),
    ("http://[a@b]@x/", "'x' does not appear to be an IPv4 or IPv6 address"),
  ]
  for case in cases {
    let (url, message) = case
    try @urllib.urlsplit(url) catch {
      @urllib.ValueError(got) => assert_eq(got, message)
    } noraise {
      _ => fail("expected \{url} to fail")
    }
  }
}

///|
test "urldefrag matches CPython" {
  let cases : Array[(String, String, String)] = [
    ("http://example.com/a#b", "http://example.com/a", "b"),
    ("http://example.com/a#", "http://example.com/a", ""),
    ("http://example.com/a", "http://example.com/a", ""),
    ("urn:example:foo#bar", "urn:example:foo", "bar"),
    ("urn:example:foo#", "urn:example:foo", ""),
    ("#", "", ""),
    ("#foo", "", "foo"),
    ("", "", ""),
    ("http://a/b;p?q#f", "http://a/b;p?q", "f"),
    ("tag:x#/a/b", "tag:x", "/a/b"),
    ("http://example.com/?#", "http://example.com/", ""),
    ("//x/y#z", "//x/y", "z"),
  ]
  for case in cases {
    let (url, defragged, fragment) = case
    let got = @urllib.urldefrag(url)
    assert_eq(got.url, defragged)
    assert_eq(got.fragment, fragment)
  }
}

///|
test "unquote matches CPython" {
  let cases : Array[(String, String)] = [
    ("", ""),
    ("abc", "abc"),
    ("abc%20def", "abc def"),
    ("%7e%7E", "~~"),
    ("%", "%"),
    ("%2", "%2"),
    ("%zz", "%zz"),
    ("%%41", "%A"),
    ("%E2%82%AC", "€"),
    ("%E2%82", "�"),
    ("%E2%82%", "�%"),
    ("%FF", "�"),
    ("%C3%A9t%C3%A9", "été"),
    ("%C3", "�"),
    ("%ED%A0%80", "���"),
    ("%F0%9F%98%80", "😀"),
    ("%F0%9F%98", "�"),
    ("café%20bar", "café bar"),
    ("é%C3%A9", "éé"),
    ("%C3é%A9", "�é�"),
    ("~0~1%7E0", "~0~1~0"),
    ("a%2Fb", "a/b"),
    ("/definitions/foo%22bar", "/definitions/foo\"bar"),
    ("%25", "%"),
    ("%2525", "%25"),
    ("%80%80", "��"),
    ("%C0%AF", "��"),
    ("%F4%90%80%80", "����"),
  ]
  for case in cases {
    let (input, expected) = case
    assert_eq(@urllib.unquote(input), expected, msg="unquote(\{input})")
  }
}
