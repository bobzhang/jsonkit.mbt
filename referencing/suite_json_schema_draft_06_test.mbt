test "suite: json-schema-draft-06/tag-uris" {
  run_suite_file(
    "json-schema-draft-06/tag-uris",
    "http://json-schema.org/draft-06/schema#",
    xfail=false,
    (
      #|{
      #|  "$schema": "../../test-schema.json",
