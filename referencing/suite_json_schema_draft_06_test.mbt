      #|    "tag:bowtie.report,2023-11:referencing-suite-tag-uris-external-id": {
      #|      "definitions": {
      #|        "foo": {
      #|          "$id": "tag:bowtie.report,2023-11:referencing-suite-tag-uris-id",
      #|          "definitions": {
      #|            "bar": {
