test "differential/306: starts_with(@, '')" {
  assert_eq(differential_outcome("starts_with(@, '')", "\"\""), "ok:true")
}

///|
test "differential/307: contains(@, '')" {
  assert_eq(differential_outcome("contains(@, '')", "\"\""), "ok:true")
}

///|
test "differential/308: contains(@, 'ab')" {
  assert_eq(differential_outcome("contains(@, 'ab')", "\"a\""), "ok:false")
}

