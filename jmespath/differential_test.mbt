    differential_outcome(
      "sort_by(@, &k)[*].i", "[{\"k\": 1.0, \"i\": 0}, {\"k\": 1.0, \"i\": 1}, {\"k\": 0, \"i\": 2}, {\"k\": 0.5, \"i\": 3}, {\"k\": 1.0, \"i\": 4}, {\"k\": 3, \"i\": 5}, {\"k\": 1, \"i\": 6}, {\"k\": 0.5, \"i\": 7}]",
