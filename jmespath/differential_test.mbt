  assert_eq(
    differential_outcome(
      "sort_by(@, &k)[*].i", "[{\"k\": 2, \"i\": 0}, {\"k\": NaN, \"i\": 1}, {\"k\": 1.0, \"i\": 2}]",
    ),
    "ok:[0,1,2]",
  )
}

