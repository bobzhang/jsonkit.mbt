test "differential/315: sort(@)" {
  assert_eq(
    differential_outcome("sort(@)", "[0.5, 0.5, -1]"),
    "ok:[-1,0.5,0.5]",
  )
}

///|
test "differential/316: sort_by(@, &k)[*].i" {
  assert_eq(
    differential_outcome(
      "sort_by(@, &k)[*].i", "[{\"k\": 0.5, \"i\": 0}, {\"k\": 0.5, \"i\": 1}, {\"k\": -1, \"i\": 2}]",
    ),
    "ok:[2,0,1]",
  )
}

///|
test "differential/317: sort(@)" {
  assert_eq(differential_outcome("sort(@)", "[2, NaN, 1.0]"), "ok:[2,NaN,1.0]")
}

///|
