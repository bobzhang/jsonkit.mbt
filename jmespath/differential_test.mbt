  )
}

///|
test "differential/253: &" {
  assert_eq(
    differential_outcome("&", "{}"),
    "err:IncompleteExpressionError:Invalid jmespath expression: Incomplete expression:\n\"&\"\n  ^",
  )
}

///|
test "differential/254: a.&b" {
  assert_eq(
    differential_outcome("a.&b", "{}"),
    "err:ParseError:Expecting: ['quoted_identifier', 'unquoted_identifier', 'lbracket', 'lbrace'], got: expref: Parse error at column 2, token \"&\" (EXPREF), for expression:\n\"a.&b\"\n   ^",
  )
}

///|
test "differential/255: @" {
  assert_eq(
    differential_outcome("@", ""),
    "err:JSONDecodeError:Expecting value: line 1 column 1 (char 0)",
  )
}

///|
test "differential/256: @" {
  assert_eq(
    differential_outcome("@", "   "),
    "err:JSONDecodeError:Expecting value: line 1 column 4 (char 3)",
  )
}

///|
test "differential/257: @" {
  assert_eq(
    differential_outcome("@", "[1,]"),
    "err:JSONDecodeError:Illegal trailing comma before end of array: line 1 column 3 (char 2)",
  )
}

///|
test "differential/258: @" {
  assert_eq(
    differential_outcome("@", "{\"a\": 1,}"),
    "err:JSONDecodeError:Illegal trailing comma before end of object: line 1 column 8 (char 7)",
  )
}

///|
test "differential/259: @" {
  assert_eq(
    differential_outcome("@", "{\"a\" 1}"),
    "err:JSONDecodeError:Expecting ':' delimiter: line 1 column 6 (char 5)",
  )
}

///|
test "differential/260: @" {
  assert_eq(
    differential_outcome("@", "{a: 1}"),
    "err:JSONDecodeError:Expecting property name enclosed in double quotes: line 1 column 2 (char 1)",
  )
}

///|
test "differential/261: @" {
  assert_eq(
    differential_outcome("@", "[1 2]"),
    "err:JSONDecodeError:Expecting ',' delimiter: line 1 column 4 (char 3)",
  )
}

///|
test "differential/262: @" {
  assert_eq(
    differential_outcome("@", "[1] x"),
    "err:JSONDecodeError:Extra data: line 1 column 5 (char 4)",
  )
}

///|
test "differential/263: @" {
  assert_eq(
    differential_outcome("@", "\"abc"),
    "err:JSONDecodeError:Unterminated string starting at: line 1 column 1 (char 0)",
  )
}

///|
test "differential/264: @" {
  assert_eq(
    differential_outcome("@", "\"a\\x\""),
    "err:JSONDecodeError:Invalid \\escape: line 1 column 3 (char 2)",
  )
}

///|
test "differential/265: @" {
  assert_eq(
    differential_outcome("@", "\"\\u12\""),
    "err:JSONDecodeError:Invalid \\uXXXX escape: line 1 column 3 (char 2)",
  )
}

///|
test "differential/266: @" {
  assert_eq(
    differential_outcome("@", "\"\\uZZZZ\""),
    "err:JSONDecodeError:Invalid \\uXXXX escape: line 1 column 3 (char 2)",
  )
}

///|
test "differential/267: @" {
  assert_eq(
    differential_outcome("@", "\"a\tb\""),
    "err:JSONDecodeError:Invalid control character at: line 1 column 3 (char 2)",
  )
}

///|
test "differential/268: @" {
  assert_eq(
    differential_outcome("@", "\n\n  [1,\n  ]"),
    "err:JSONDecodeError:Illegal trailing comma before end of array: line 3 column 5 (char 6)",
  )
}

///|
test "differential/269: @" {
  assert_eq(
    differential_outcome("@", "﻿[]"),
    "err:JSONDecodeError:Unexpected UTF-8 BOM (decode using utf-8-sig): line 1 column 1 (char 0)",
  )
}

///|
test "differential/270: @" {
  assert_eq(
    differential_outcome("@", "-"),
    "err:JSONDecodeError:Expecting value: line 1 column 1 (char 0)",
  )
}

///|
test "differential/271: @" {
  assert_eq(
    differential_outcome("@", "01"),
    "err:JSONDecodeError:Extra data: line 1 column 2 (char 1)",
  )
}

///|
test "differential/272: @" {
  assert_eq(
    differential_outcome("@", "1."),
    "err:JSONDecodeError:Extra data: line 1 column 2 (char 1)",
  )
}

///|
test "differential/273: @" {
  assert_eq(
    differential_outcome("@", ".5"),
    "err:JSONDecodeError:Expecting value: line 1 column 1 (char 0)",
  )
}

///|
test "differential/274: @" {
  assert_eq(
    differential_outcome("@", "tru"),
    "err:JSONDecodeError:Expecting value: line 1 column 1 (char 0)",
  )
}

///|
test "differential/275: @" {
  assert_eq(
    differential_outcome("@", "\"éé\" x"),
    "err:JSONDecodeError:Extra data: line 1 column 6 (char 5)",
  )
}

///|
test "differential/276: [1::2147483647]" {
  assert_eq(differential_outcome("[1::2147483647]", "[0, 1, 2]"), "ok:[1]")
}

///|
test "differential/277: [0::2147483647]" {
  assert_eq(differential_outcome("[0::2147483647]", "[0, 1, 2]"), "ok:[0]")
}

///|
test "differential/278: [::-2147483647]" {
  assert_eq(differential_outcome("[::-2147483647]", "[0, 1, 2]"), "ok:[2]")
}

///|
test "differential/279: [::-2147483648]" {
  assert_eq(differential_outcome("[::-2147483648]", "[0, 1, 2]"), "ok:[2]")
}

///|
test "differential/280: [1::-2147483648]" {
  assert_eq(differential_outcome("[1::-2147483648]", "[0, 1, 2]"), "ok:[1]")
}

///|
test "differential/281: [-2147483648:2147483647]" {
  assert_eq(
    differential_outcome("[-2147483648:2147483647]", "[0, 1, 2]"),
    "ok:[0,1,2]",
  )
}

///|
test "differential/282: [2147483647:-2147483648:-1]" {
  assert_eq(
    differential_outcome("[2147483647:-2147483648:-1]", "[0, 1, 2]"),
    "ok:[2,1,0]",
  )
}

///|
test "differential/283: [::99999999999]" {
  assert_eq(differential_outcome("[::99999999999]", "[0, 1, 2]"), "ok:[0]")
}

///|
test "differential/284: [::-99999999999]" {
  assert_eq(differential_outcome("[::-99999999999]", "[0, 1, 2]"), "ok:[2]")
}

///|
test "differential/285: sum(@)" {
  assert_eq(differential_outcome("sum(@)", "[1, 1e16, -1e16]"), "ok:0.0")
}

///|
test "differential/286: sum(@)" {
  assert_eq(differential_outcome("sum(@)", "[1e16, 1, -1e16]"), "ok:0.0")
}

///|
test "differential/287: sum(@)" {
  assert_eq(
    differential_outcome("sum(@)", "[0.5, 1e16, 1, 1, -1e16]"),
    "ok:0.5",
  )
}

///|
test "differential/288: sum(@)" {
  assert_eq(
    differential_outcome("sum(@)", "[3, 0.1, 1e16, -1e16, 0.2]"),
    "ok:3.3",
  )
}

///|
test "differential/289: avg(@)" {
  assert_eq(differential_outcome("avg(@)", "[1, 1e16, -1e16]"), "ok:0.0")
}

///|
test "differential/290: @ == @" {
  assert_eq(differential_outcome("@ == @", "[NaN]"), "ok:true")
}

///|
test "differential/291: @[0] == @[0]" {
  assert_eq(differential_outcome("@[0] == @[0]", "[NaN]"), "ok:false")
}

///|
test "differential/292: @ == `[NaN]`" {
  assert_eq(differential_outcome("@ == `[NaN]`", "[NaN]"), "ok:true")
}

///|
test "differential/293: `[NaN]` == `[NaN]`" {
  assert_eq(differential_outcome("`[NaN]` == `[NaN]`", "{}"), "ok:true")
}

///|
test "differential/294: {a: @[0]} == {a: @[0]}" {
  assert_eq(differential_outcome("{a: @[0]} == {a: @[0]}", "[NaN]"), "ok:true")
}

///|
test "differential/295: [@[0]] == [@[1]]" {
  assert_eq(differential_outcome("[@[0]] == [@[1]]", "[NaN, NaN]"), "ok:true")
}

///|
test "differential/296: contains(@, `NaN`)" {
  assert_eq(differential_outcome("contains(@, `NaN`)", "[NaN]"), "ok:true")
}

///|
test "differential/297: contains(@, @[1])" {
  assert_eq(differential_outcome("contains(@, @[1])", "[1, NaN]"), "ok:true")
}

///|
test "differential/298: contains(@, to_number('nan'))" {
  assert_eq(
    differential_outcome("contains(@, to_number('nan'))", "[NaN]"),
    "ok:false",
  )
}

///|
test "differential/299: [to_number('nan')] == [to_number('nan')]" {
  assert_eq(
    differential_outcome("[to_number('nan')] == [to_number('nan')]", "{}"),
    "ok:false",
  )
}

///|
test "differential/300: @ == @" {
  assert_eq(differential_outcome("@ == @", "[1e400]"), "ok:true")
}

///|
test "differential/301: contains(@, `\"\\ud83d\"`)" {
  assert_eq(
    differential_outcome("contains(@, `\"\\ud83d\"`)", "\"\\ud83d\\ude00\""),
    "ok:false",
  )
}

///|
test "differential/302: contains(@, `\"\\ude00\"`)" {
  assert_eq(
    differential_outcome("contains(@, `\"\\ude00\"`)", "\"\\ud83d\\ude00\""),
    "ok:false",
  )
}

